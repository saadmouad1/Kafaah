/* V14.2 Scalable Question Store
   IndexedDB is the source of truth. RAM is only a small page/cache.
   Designed for large banks without loading the full database into memory.
*/
(function(){
'use strict';
var DB_NAME='MedicalQuestionIntelligenceDB';
var DB_VERSION=7;
var STORE='questions';
var META='meta';
var BATCH_SIZE=250;
var MAX_CACHE=750;
var dbPromise=null;
var INDEXES=['databaseType','questionBank','bankName','medicalProfession','qualification','specialty','country','city','governorate','year','subject','section','topic','title','examTitle','examProvider','examType','exactDate','questionSignature','analysisKey','patternKey'];
function openDB(){
 if(dbPromise)return dbPromise;
 dbPromise=new Promise(function(resolve,reject){
  var r=indexedDB.open(DB_NAME,DB_VERSION);
  r.onupgradeneeded=function(){
   var d=r.result,t=r.transaction,s=d.objectStoreNames.contains(STORE)?t.objectStore(STORE):d.createObjectStore(STORE,{keyPath:'id'});
   INDEXES.forEach(function(k){if(!s.indexNames.contains(k))s.createIndex(k,k,{unique:false});});
   if(!d.objectStoreNames.contains(META))d.createObjectStore(META,{keyPath:'key'}); if(!s.indexNames.contains('intelligenceTokens'))s.createIndex('intelligenceTokens','intelligenceTokens',{unique:false,multiEntry:true}); else {try{t.objectStore(STORE).deleteIndex('intelligenceTokens');}catch(e){} s.createIndex('intelligenceTokens','intelligenceTokens',{unique:false,multiEntry:true});}
   /* Legacy records without databaseType belong to the original licensure database. */
   if(r.oldVersion<4 && d.objectStoreNames.contains(STORE)){var cur=s.openCursor();cur.onsuccess=function(){var c=cur.result;if(!c)return;var v=c.value||{};if(!v.databaseType){v.databaseType='licensure';c.update(v);}c.continue();};} if(r.oldVersion<5 && d.objectStoreNames.contains(STORE)){var cur5=s.openCursor();cur5.onsuccess=function(){var c5=cur5.result;if(!c5)return;var v5=c5.value||{};if(!v5.questionSignature)v5.questionSignature=normalizeSignature(v5.originalQuestion);if(!v5.analysisKey)v5.analysisKey=makeAnalysisKey(v5);if(!v5.patternKey)v5.patternKey=makePatternKey(v5);c5.update(v5);c5.continue();};} if(r.oldVersion<6 && d.objectStoreNames.contains(STORE)){var cur6=s.openCursor();cur6.onsuccess=function(){var c6=cur6.result;if(!c6)return;var v6=c6.value||{};v6.intelligenceTokens=makeIntelligenceTokens(v6);c6.update(v6);c6.continue();};}
  };
  r.onsuccess=function(){var d=r.result;d.onversionchange=function(){d.close();dbPromise=null;};resolve(d);};
  r.onerror=function(){reject(r.error||new Error('IndexedDB open failed'));};
 });return dbPromise;
}
function writeBatch(rows){rows=(rows||[]).map(prepareRow);return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readwrite'),s=t.objectStore(STORE),i;try{for(i=0;i<rows.length;i++)s.put(rows[i]);}catch(e){try{t.abort();}catch(_){ }reject(e);return;}t.oncomplete=function(){resolve(rows.length);};t.onerror=function(){reject(t.error||new Error('IndexedDB write failed'));};t.onabort=function(){reject(t.error||new Error('IndexedDB transaction aborted'));};});});}
function putMany(rows){rows=Array.isArray(rows)?rows:[];if(!rows.length)return Promise.resolve(0);var total=0,pos=0;function next(){if(pos>=rows.length)return Promise.resolve(total);var chunk=rows.slice(pos,Math.min(pos+BATCH_SIZE,rows.length));pos+=chunk.length;return writeBatch(chunk).then(function(n){total+=n;return next();});}return next();}
function request(req){return new Promise(function(resolve,reject){req.onsuccess=function(){resolve(req.result);};req.onerror=function(){reject(req.error);};});}
function count(){return openDB().then(function(d){return request(d.transaction(STORE,'readonly').objectStore(STORE).count());});}
function get(id){return openDB().then(function(d){return request(d.transaction(STORE,'readonly').objectStore(STORE).get(id));});}
function getMany(ids){ids=Array.isArray(ids)?ids:[];if(!ids.length)return Promise.resolve([]);return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readonly'),s=t.objectStore(STORE),out=[],left=ids.length,i;function one(id){var r=s.get(id);r.onsuccess=function(){if(r.result)out.push(r.result);if(!--left)resolve(out);};r.onerror=function(){reject(r.error);};}for(i=0;i<ids.length;i++)one(ids[i]);});});}
function clear(){return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction([STORE,META],'readwrite');t.objectStore(STORE).clear();t.objectStore(META).clear();t.oncomplete=function(){resolve(true);};t.onerror=function(){reject(t.error);};t.onabort=function(){reject(t.error||new Error('IndexedDB clear aborted'));};});});}
function valueOf(q,k){var v=q&&q[k];return v==null?'':String(v);}
function normalizeSignature(v){return String(v==null?'':v).toLowerCase().replace(/[\u2018\u2019\u201c\u201d'"`]/g,'').replace(/[^\p{L}\p{N}\s]/gu,' ').replace(/\s+/g,' ').trim();}
function makeAnalysisKey(q){var subject=normalizeSignature(q&&q.subject),topic=normalizeSignature(q&&q.topic),question=normalizeSignature(q&&q.originalQuestion);var words=question.split(' ').filter(function(w){return w.length>2;}).slice(0,18);return (subject+'||'+topic+'||'+words.join(' ')).slice(0,500);}
function makePatternKey(q){var subject=normalizeSignature(q&&q.subject),topic=normalizeSignature(q&&q.topic),question=normalizeSignature(q&&q.originalQuestion);var stop={'the':1,'and':1,'or':1,'of':1,'what':1,'which':1,'for':1,'is':1,'are':1,'was':1,'were':1,'to':1,'in':1,'on':1,'a':1,'an':1,'from':1,'with':1,'by':1,'be':1,'patient':1,'following':1,'most':1,'likely':1};var words=question.split(' ').filter(function(w){return w.length>3&&!stop[w];}).sort();return (subject+'||'+topic+'||'+words.slice(0,10).join('|')).slice(0,500);}
function optionText(q){var o=q&&q.originalOptions||q&&q.options||{},a=[],k;for(k in o)if(o[k]!=null)a.push(String(o[k]));return a.join(' ');}
function tokenArray(text){var s=normalizeSignature(text),stop={'the':1,'and':1,'or':1,'of':1,'what':1,'which':1,'for':1,'is':1,'are':1,'was':1,'were':1,'to':1,'in':1,'on':1,'a':1,'an':1,'from':1,'with':1,'by':1,'be':1,'patient':1,'following':1,'most':1,'likely':1,'does':1,'do':1,'not':1,'than':1,'seen':1,'true':1,'false':1,'all':1,'may':1,'can':1,'should':1},m={},out=[],a=s.split(' '),i,w;for(i=0;i<a.length;i++){w=a[i];if(w.length>3&&!stop[w]&&!m[w]){m[w]=1;out.push(w);}}return out;}
function makeIntelligenceTokens(q){var all=[q&&q.originalQuestion||'',optionText(q),q&&q.subject||'',q&&q.topic||'',q&&q.title||'',Array.isArray(q&&q.tags)?q.tags.join(' '):q&&q.tags||''].join(' ');return tokenArray(all).slice(0,40);}
function jaccardText(a,b){var A=tokenArray(a),B=tokenArray(b),m={},i,inter=0,uni,seen={};for(i=0;i<A.length;i++)m[A[i]]=1;for(i=0;i<B.length;i++)if(m[B[i]])inter++;for(i=0;i<A.length;i++)seen[A[i]]=1;for(i=0;i<B.length;i++)seen[B[i]]=1;uni=Object.keys(seen).length;return uni?inter/uni:0;}
function intelligenceScore(a,b){var q=jaccardText(a&&a.originalQuestion,b&&b.originalQuestion),o=jaccardText(optionText(a),optionText(b)),t=jaccardText(a&&a.topic,b&&b.topic),s=jaccardText(a&&a.subject,b&&b.subject),ti=jaccardText(a&&a.title,b&&b.title),tag=jaccardText(Array.isArray(a&&a.tags)?a.tags.join(' '):a&&a.tags,Array.isArray(b&&b.tags)?b.tags.join(' '):b&&b.tags);var score=.42*q+.25*o+.12*t+.08*s+.08*ti+.05*tag;if(t>0)score+=.06;if(s>0)score+=.03;return Math.min(1,score);}
function prepareRow(q){q=q||{};if(!q.questionSignature)q.questionSignature=normalizeSignature(q.originalQuestion);if(!q.analysisKey)q.analysisKey=makeAnalysisKey(q);if(!q.patternKey)q.patternKey=makePatternKey(q);if(!q.intelligenceTokens)q.intelligenceTokens=makeIntelligenceTokens(q);return q;}
function rowMode(q){var v=valueOf(q,'databaseType');return v==='global'?'global':'licensure';}
function matches(q,filters){if(!filters)return true;for(var k in filters){var want=filters[k];if(want===undefined||want===null||want===''||(Array.isArray(want)&&!want.length))continue;var got=valueOf(q,k);if(Array.isArray(want)){var ok=false;for(var wi=0;wi<want.length;wi++)if(got===String(want[wi])){ok=true;break;}if(!ok)return false;}else if(k==='databaseType'){if(rowMode(q)!==String(want))return false;}else if(got!==String(want))return false;}return true;}
function sourceScopeMatches(q,scope){if(!scope)return true;var qm=rowMode(q),gb=(scope.globalBanks||[]),le=(scope.licensureExams||[]),i,v;if(qm==='global'){if(!gb.length)return false;v=valueOf(q,'questionBank')||valueOf(q,'bankName');for(i=0;i<gb.length;i++)if(v===String(gb[i]))return true;return false;}if(qm==='licensure'){if(!le.length)return false;v=valueOf(q,'examTitle')||valueOf(q,'exam');for(i=0;i<le.length;i++)if(v===String(le[i]))return true;return false;}return false;}
function flattenSearchText(v,out){out=out||[];if(v===null||v===undefined)return out;if(typeof v==='string'||typeof v==='number'||typeof v==='boolean'){out.push(String(v));return out;}if(Array.isArray(v)){for(var i=0;i<v.length;i++)flattenSearchText(v[i],out);return out;}if(typeof v==='object'){for(var k in v)if(Object.prototype.hasOwnProperty.call(v,k))flattenSearchText(v[k],out);}return out;}
function query(filters,opts){opts=opts||{};var limit=Math.max(0,Number(opts.limit)||50),offset=Math.max(0,Number(opts.offset)||0),search=String(opts.search||'').toLowerCase(),mode=opts.mode||'',sourceScope=opts.sourceScope||null,fieldSearch=opts.searchFields||['originalQuestion','subject','topic','title','tags'];return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readonly'),s=t.objectStore(STORE),c=s.openCursor(),out=[],matched=0,total=0,done=false;c.onsuccess=function(){var cur=c.result;if(!cur){done=true;resolve({rows:out,total:total});return;}var q=cur.value;if((!mode||rowMode(q)===mode)&&(!sourceScope||sourceScopeMatches(q,sourceScope))&&matches(q,filters)){var hay='';if(search){if(opts.searchAll){hay=flattenSearchText(q,[]).join(' ').toLowerCase();}else{for(var z=0;z<fieldSearch.length;z++){var vv=q[fieldSearch[z]];hay+=' '+(Array.isArray(vv)?vv.join(' '):String(vv==null?'':vv));}hay=hay.toLowerCase();}}if(!search||hay.indexOf(search)>=0){if(matched>=offset&&out.length<limit)out.push(q);matched++;total++;}}cur.continue();};c.onerror=function(){reject(c.error||t.error);};t.onerror=function(){if(!done)reject(t.error||new Error('IndexedDB query failed'));};});});}
function distinct(field,filters,mode){return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readonly'),c=t.objectStore(STORE).openCursor(),m={},a=[];c.onsuccess=function(){var x=c.result;if(!x){a.sort();resolve(a);return;}var q=x.value;if((!mode||rowMode(q)===mode)&&matches(q,filters)){var v=valueOf(q,field);if(v&&!m[v]){m[v]=1;a.push(v);}}x.continue();};c.onerror=function(){reject(c.error||t.error);};});});}
function countWhere(filters,mode){return query(filters,{limit:0,offset:0,mode:mode}).then(function(x){return x.total;});}
function sample(limit,mode){return query({}, {limit:Math.max(0,Number(limit)||0),offset:0,mode:mode}).then(function(x){return x.rows;});}
function groupedIndex(indexName,mode){return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readonly'),idx=t.objectStore(STORE).index(indexName),c=idx.openCursor(),rows=[],current=null,count=0,done=false;c.onsuccess=function(){var cur=c.result;if(!cur){if(current!==null&&count>1)rows.push({key:current,count:count});rows.sort(function(a,b){return b.count-a.count;});done=true;resolve(rows.slice(0,100));return;}var q=cur.value||{},qm=rowMode(q),key=String(cur.key||'');if(mode&&qm!==mode){cur.continue();return;}if(current===null)current=key;if(key!==current){if(count>1)rows.push({key:current,count:count});current=key;count=0;}count++;cur.continue();};c.onerror=function(){reject(c.error||t.error);};t.onerror=function(){if(!done)reject(t.error||new Error('IndexedDB grouped scan failed'));};});});}
function baseFrequency(mode){return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readonly'),c=t.objectStore(STORE).openCursor(),subjects={},topics={},licSubjects={},licTopics={},globalSubjects={},globalTopics={},crossTopic={},total=0,licTotal=0,globalTotal=0,done=false;c.onsuccess=function(){var cur=c.result;if(!cur){resolve({total:total,licensureTotal:licTotal,globalTotal:globalTotal,subjects:toRows(subjects),topics:toRows(topics),licensureSubjects:toRows(licSubjects),licensureTopics:toRows(licTopics),globalSubjects:toRows(globalSubjects),globalTopics:toRows(globalTopics),crossTopics:topicOverlapRows(crossTopic)});return;}var q=cur.value||{},qm=rowMode(q);if(mode&&qm!==mode){cur.continue();return;}total++;if(qm==='licensure')licTotal++;else globalTotal++;var su=valueOf(q,'subject')||'Uncategorized',to=valueOf(q,'topic')||'Uncategorized';subjects[su]=(subjects[su]||0)+1;topics[to]=(topics[to]||0)+1;if(qm==='licensure'){licSubjects[su]=(licSubjects[su]||0)+1;licTopics[to]=(licTopics[to]||0)+1;}else{globalSubjects[su]=(globalSubjects[su]||0)+1;globalTopics[to]=(globalTopics[to]||0)+1;}if(!crossTopic[to])crossTopic[to]={licensure:0,global:0};crossTopic[to][qm]++;cur.continue();};c.onerror=function(){reject(c.error||t.error);};t.onerror=function(){if(!done)reject(t.error||new Error('Frequency scan failed'));};});});}
function topicOverlapRows(m){var a=[],k;for(k in m)a.push({key:k,licensure:m[k].licensure||0,global:m[k].global||0,total:(m[k].licensure||0)+(m[k].global||0)});a.sort(function(x,y){return y.total-x.total;});return a.slice(0,100);}
function groupOccurrences(indexName,key,mode,limit){
 limit=Math.max(1,Math.min(100,Number(limit)||50));
 return openDB().then(function(d){return new Promise(function(resolve,reject){
  var t=d.transaction(STORE,'readonly'),idx=t.objectStore(STORE).index(indexName),r=idx.getAll(IDBKeyRange.only(key),limit),out=[];
  r.onsuccess=function(){var rows=r.result||[],i,q;for(i=0;i<rows.length;i++){q=rows[i]||{};if(mode&&rowMode(q)!==mode)continue;out.push({
   id:q.id||'',databaseType:rowMode(q),questionBank:q.questionBank||q.bankName||'',examTitle:q.examTitle||'',examProvider:q.examProvider||'',medicalProfession:q.medicalProfession||'',qualification:q.qualification||'',specialty:q.specialty||'',country:q.country||'',city:q.city||'',governorate:q.governorate||'',year:q.year||'',month:q.month||'',exactDate:q.exactDate||'',subject:q.subject||'',section:q.section||'',topic:q.topic||'',title:q.title||'',questionNumber:q.questionNumber||'',originalQuestion:q.originalQuestion||''
  });}resolve(out);};
  r.onerror=function(){reject(r.error||new Error('Failed to load repeated question occurrences'));};
 });});
}
function meaningfulTokens(q){
 var s=normalizeSignature(q&&q.originalQuestion),stop={'the':1,'and':1,'or':1,'of':1,'what':1,'which':1,'for':1,'is':1,'are':1,'was':1,'were':1,'to':1,'in':1,'on':1,'a':1,'an':1,'from':1,'with':1,'by':1,'be':1,'patient':1,'following':1,'most':1,'likely':1,'does':1,'do':1,'not':1,'than':1,'seen':1,'true':1,'false':1};
 var a=s.split(' ').filter(function(w){return w.length>3&&!stop[w];});var m={},out=[],i;for(i=0;i<a.length;i++)if(!m[a[i]]){m[a[i]]=1;out.push(a[i]);}return out.slice(0,14);
}
function crossDatabaseSimilarGroups(mode){
 return openDB().then(function(d){return new Promise(function(resolve,reject){
  var top=[],seenPairs={},sourceCount=0,MAX_SOURCES=5000,MAX_CAND=100,done=false;
  function pushPair(item){var key=item.licensure.id+'::'+item.global.id;if(seenPairs[key])return;seenPairs[key]=1;top.push(item);top.sort(function(a,b){return b.score-a.score||b.optionSimilarity-a.optionSimilarity;});if(top.length>100)top.length=100;}
  function getCandidates(q){
   return new Promise(function(res,rej){
    var ids={},cands=[],pending=0,finished=false;
    function add(rows){for(var i=0;i<rows.length;i++){var x=rows[i];if(rowMode(x)==='global'&&!ids[x.id]){ids[x.id]=1;cands.push(x);if(cands.length>=MAX_CAND)break;}}}
    function finish(){if(!finished&&pending===0){finished=true;res(cands);}}
    var topic=normalizeSignature(q.topic),subject=normalizeSignature(q.subject);
    var d2;
    try{d2=openDB();}catch(e){rej(e);return;}
    d2.then(function(db){
      var searches=[];
      if(topic)searches.push(['topic',topic]);
      if(subject)searches.push(['subject',subject]);
      var toks=(q.intelligenceTokens||makeIntelligenceTokens(q)).slice(0,10);
      for(var ti=0;ti<toks.length&&searches.length<12;ti++)searches.push(['intelligenceTokens',toks[ti]]);
      if(!searches.length){res([]);return;}
      pending=searches.length;
      searches.forEach(function(pair){var tx=db.transaction(STORE,'readonly'),ix=tx.objectStore(STORE).index(pair[0]),r=ix.getAll(IDBKeyRange.only(pair[1]),MAX_CAND);r.onsuccess=function(){add(r.result||[]);pending--;finish();};r.onerror=function(){pending--;finish();};});
    }).catch(rej);
   });
  }
  function scoreOne(q){return getCandidates(q).then(function(cands){for(var i=0;i<cands.length;i++){var g=cands[i];if(!g||g.id===q.id)continue;var score=intelligenceScore(q,g);var qs=jaccardText(q.originalQuestion,g.originalQuestion),os=jaccardText(optionText(q),optionText(g)),ts=jaccardText(q.topic,g.topic),ss=jaccardText(q.subject,g.subject),tls=jaccardText(q.title,g.title);if(score<0.30&&!(ts>=0.8&&qs>=0.15))continue;var level=score>=0.82?'Very High':score>=0.68?'High':score>=0.52?'Moderate':'Related';pushPair({score:score,matchLevel:level,questionSimilarity:qs,optionSimilarity:os,topicSimilarity:ts,subjectSimilarity:ss,titleSimilarity:tls,sameTopic:ts>=0.8,sameSubject:ss>=0.8,licensure:q,global:g});}});}
  function scanCursor(){var tx=d.transaction(STORE,'readonly'),cur=tx.objectStore(STORE).openCursor();cur.onsuccess=function(){var c=cur.result;if(!c){done=true;resolve({pairs:top.slice(0,100),sourcesAnalyzed:sourceCount});return;}var q=c.value||{};if(rowMode(q)==='licensure'&&sourceCount<MAX_SOURCES){sourceCount++;scoreOne(q).then(function(){c.continue();}).catch(function(){c.continue();});}else c.continue();};cur.onerror=function(){if(!done)reject(cur.error||new Error('Cross-database source scan failed'));};tx.onerror=function(){if(!done)reject(tx.error||new Error('Cross-database source transaction failed'));};}
  if(mode==='global-to-licensure'){
    // reverse direction: temporarily swap labels by scanning global sources and querying licensure candidates
    // implemented by using the same source scan with row modes inverted below
  }
  scanCursor();
 });});
}
function autoCrossDatabasePairs(limit){
 limit=Math.max(1,Math.min(100,Number(limit)||30));
 return crossDatabaseSimilarGroups('licensure-to-global').then(function(out){out.pairs=out.pairs.slice(0,limit);return out;});
}

function frequencyAnalysis(opts){opts=opts||{};var mode=opts.mode||'';return Promise.all([baseFrequency(mode),groupedIndex('questionSignature',mode),groupedIndex('patternKey',mode),crossDatabaseSimilarGroups(mode)]).then(function(v){return {total:v[0].total,licensureTotal:v[0].licensureTotal,globalTotal:v[0].globalTotal,subjects:v[0].subjects,topics:v[0].topics,licensureSubjects:v[0].licensureSubjects,licensureTopics:v[0].licensureTopics,globalSubjects:v[0].globalSubjects,globalTopics:v[0].globalTopics,crossTopics:v[0].crossTopics,exact:v[1],patterns:v[2],crossSimilar:v[3]};});}

function toRows(m){var a=[],k;for(k in m)a.push({key:k,count:m[k]});a.sort(function(x,y){return y.count-x.count;});return a.slice(0,100);}
function tokenSet(q){var s=normalizeSignature(q&&q.originalQuestion),a=s.split(' ').filter(function(w){return w.length>3;});var m={},i;for(i=0;i<a.length;i++)m[a[i]]=1;return m;}
function similarityScore(a,b){var A=tokenSet(a),B=tokenSet(b),ka=Object.keys(A),kb=Object.keys(B),inter=0,i;if(!ka.length||!kb.length)return 0;for(i=0;i<ka.length;i++)if(B[ka[i]])inter++;var union=ka.length+kb.length-inter;return union?inter/union:0;}
function pushTop(arr,item,limit){arr.push(item);arr.sort(function(a,b){return b.score-a.score;});if(arr.length>limit)arr.length=limit;}
function crossMatches(questionId,limit){limit=Math.max(1,Math.min(30,Number(limit)||10));return get(questionId).then(function(q){if(!q)return {exact:[],similar:[]};var qs=normalizeSignature(q.originalQuestion),sub=normalizeSignature(q.subject),top=normalizeSignature(q.topic);return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readonly'),c=t.objectStore(STORE).openCursor(),exact=[],sim=[],done=false;c.onsuccess=function(){var cur=c.result;if(!cur){done=true;resolve({exact:exact.slice(0,limit),similar:sim.slice(0,limit)});return;}var x=cur.value||{};if(x.id!==q.id){var xs=normalizeSignature(x.originalQuestion);if(xs&&qs&&xs===qs){if(exact.length<limit)exact.push(x);}else{var sameTopic=top&&normalizeSignature(x.topic)===top;var sameSubject=sub&&normalizeSignature(x.subject)===sub;if(sameTopic||sameSubject){var score=similarityScore(q,x);if(score>=0.32)pushTop(sim,{q:x,score:score,sameTopic:sameTopic,sameSubject:sameSubject},limit);}}}cur.continue();};c.onerror=function(){reject(c.error||t.error);};t.onerror=function(){if(!done)reject(t.error||new Error('Cross-database matching failed'));};});});});}

function crossIntelligenceSearch(opts){
 opts=opts||{};
 var sourceId=opts.sourceId||'', direction=opts.direction||'licensure-to-global', limit=Math.max(1,Math.min(50,Number(opts.limit)||20)), queryText=String(opts.query||'').trim();
 function candidatesFor(d,tokens,sourceMode){return new Promise(function(resolve,reject){var seen={},out=[],pending=tokens.length,done=false;if(!pending){resolve(out);return;}var tx=d.transaction(STORE,'readonly'),ix=tx.objectStore(STORE).index('intelligenceTokens');function finish(){if(!done&&pending===0){done=true;resolve(out);}}for(var i=0;i<tokens.length;i++){(function(token){var r=ix.getAll(IDBKeyRange.only(token),160);r.onsuccess=function(){var a=r.result||[];for(var j=0;j<a.length;j++){var q=a[j];if(rowMode(q)!==sourceMode&&!seen[q.id]){seen[q.id]=1;out.push(q);}}pending--;finish();};r.onerror=function(){pending--;if(pending===0&&!done){done=true;reject(r.error||new Error('Candidate lookup failed'));}};})(tokens[i]);}tx.onerror=function(){if(!done)reject(tx.error||new Error('Candidate transaction failed'));};});}
 function scoreSource(d,src){var tokens=(src.intelligenceTokens||makeIntelligenceTokens(src)).slice(0,16);return candidatesFor(d,tokens,rowMode(src)).then(function(cands){var arr=[];for(var i=0;i<cands.length;i++){var q=cands[i];var score=intelligenceScore(src,q);var qs=normalizeSignature(src.originalQuestion),qm=normalizeSignature(q.originalQuestion);var level=qs&&qm&&qs===qm?'Exact':(score>=.78?'Very High':(score>=.60?'High':'Conceptual'));if(score>=.27){arr.push({source:src,match:q,score:score,matchLevel:level,questionSimilarity:jaccardText(src.originalQuestion,q.originalQuestion),optionSimilarity:jaccardText(optionText(src),optionText(q)),sameTopic:normalizeSignature(src.topic)===normalizeSignature(q.topic)&&!!src.topic,sameSubject:normalizeSignature(src.subject)===normalizeSignature(q.subject)&&!!src.subject});}}arr.sort(function(a,b){return b.score-a.score;});return arr.slice(0,limit);});}
 function scoreSources(d,sources){var chain=Promise.resolve([]);sources.forEach(function(src){chain=chain.then(function(all){return scoreSource(d,src).then(function(m){for(var i=0;i<m.length;i++)all.push(m[i]);return all;});});});return chain.then(function(all){all.sort(function(a,b){return b.score-a.score||b.optionSimilarity-a.optionSimilarity;});return all.slice(0,limit);});}
 if(sourceId)return get(sourceId).then(function(src){if(!src)return {source:null,matches:[]};return openDB().then(function(d){return scoreSource(d,src).then(function(matches){return {source:src,matches:matches};});});});
 var mode=direction==='global-to-licensure'?'global':'licensure';
 return query({}, {search:queryText,limit:20,offset:0,mode:mode,searchAll:true}).then(function(out){return openDB().then(function(d){return scoreSources(d,out.rows||[]).then(function(matches){return {sources:out.rows||[],matches:matches,totalSources:out.total||0,direction:direction};});});});
}

function exportAll(filters,mode){return openDB().then(function(d){return new Promise(function(resolve,reject){var t=d.transaction(STORE,'readonly'),c=t.objectStore(STORE).openCursor(),out=[];c.onsuccess=function(){var x=c.result;if(!x){resolve(out);return;}if((!mode||rowMode(x.value)===mode)&&matches(x.value,filters))out.push(x.value);x.continue();};c.onerror=function(){reject(c.error||t.error);};});});}
window.MQIStore={open:openDB,putMany:putMany,count:count,get:get,getMany:getMany,clear:clear,sample:sample,query:query,distinct:distinct,countWhere:countWhere,exportAll:exportAll,frequencyAnalysis:frequencyAnalysis,groupOccurrences:groupOccurrences,crossMatches:crossMatches,crossIntelligenceSearch:crossIntelligenceSearch,autoCrossDatabasePairs:autoCrossDatabasePairs,MAX_CACHE:MAX_CACHE,BATCH_SIZE:BATCH_SIZE};
})();
